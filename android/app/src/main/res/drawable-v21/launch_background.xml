<?xml version="1.0" encoding="utf-8"?>
<!-- Native Android Splash Screen for API 21+ -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Warm ivory background matching Flutter splash palette (#FAF5ED) -->
    <item>
        <color android:color="#FAF5ED" />
    </item>

    <!-- App icon in center (using launcher icon) -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
